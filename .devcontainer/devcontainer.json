{
  "name": "Project Root",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "8.0"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.9",
      "tflint": "latest"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers-extra/features/uv:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers-community/features/deno:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers-extra/features/pre-commit:2": {
      "version": "latest"
    }
  },

  "customizations": {
    "vscode": {
      // "extensions" for this project are specified in here will be installed in Dev Container.
      "extensions": [
        "esbenp.prettier-vscode",
        "GitHub.vscode-github-actions",
        "golang.go",
        "hashicorp.terraform",
        "redhat.vscode-yaml",
        "rust-lang.rust-analyzer",
        "ms-azuretools.vscode-azureresourcegroups",
        "ms-azuretools.vscode-azureterraform",
        "ms-dotnettools.csharp",
        "ms-python.python",
        "ms-vscode.azurecli",
        "ms-vscode.makefile-tools"
      ]
      // "settings" for this project must be placed in infra/terraform/.vscode/settings.json.
      // DevContainer automatically inherits the workspace settings.json.
      // "settings": {}
    }
  },

  "remoteUser": "vscode"
}
